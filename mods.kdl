window-rule {
  match app-id="Alacritty"
  default-column-width { proportion 0.55; }
}

window-rule {
  match app-id="imv"
  open-floating true
}

window-rule {
  match app-id="vlc"
  open-floating true
}

window-rule {
  match app-id="Godot"
  open-maximized true
}

window-rule {
  match app-id="brave"
  open-maximized true
}

window-rule {
  match app-id="firefox"
  open-maximized true
}

window-rule {
  match app-id="obsidian"
  open-maximized true
}

binds{
  Mod+P          hotkey-overlay-title="- Task manager: Btop" { spawn "alacritty" "-e" "btop"; }
  Mod+V          hotkey-overlay-title="- Media player: vlc" { spawn "vlc"; }
  Mod+Y          hotkey-overlay-title="- Cava" { spawn "alacritty" "-e" "cava"; }
  Mod+N          hotkey-overlay-title="- Open Text Editor: Neovim" { spawn "alacritty" "-e" "nvim"; }
  Mod+E          hotkey-overlay-title="- File Manager: Yazi" { spawn "alacritty" "-e" "yazi"; }

  XF86AudioPlay  allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

  // ─── Screenshots ───
  Print                               { screenshot; }
  CTRL+Print                          { screenshot-screen; }
  CTRL+ALT+Print                      { screenshot-window; }
}
